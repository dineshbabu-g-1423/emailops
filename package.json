{
  "name": "emailops",
  "version": "1.0.0",
  "description": "Email Deliverability Intelligence Engine — deterministic root-cause classification, reputation scoring, and safe action planning from raw delivery signals, with a pluggable explanation layer.",
  "type": "module",
  "bin": {
    "emailops": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "emailops": "tsx src/cli/index.ts",
    "analyze": "tsx src/cli/index.ts analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "email",
    "deliverability",
    "smtp",
    "mta",
    "reputation",
    "root-cause",
    "anomaly-detection",
    "emailops"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
